---
import {
  ACCENT_COLORS,
  ANNOUNCEMENT,
  BENEFIT_ITEMS,
  FREE_SHIPPING_THRESHOLD,
  KITS,
  PRODUCTS,
  SHIPPING_FLAT,
  SHOP_NEEDS,
  TAX_RATE,
  TESTIMONIALS,
} from "../../data/yoga-verde-store";

const accentOf = (item: { use?: string }) => ACCENT_COLORS[item.use as keyof typeof ACCENT_COLORS] || ACCENT_COLORS.terracota;
import "../../styles/yoga-verde.css";

const money = new Intl.NumberFormat("es-MX", {
  style: "currency",
  currency: "MXN",
  maximumFractionDigits: 0,
});

const formatMoney = (value: number) => money.format(value);
const stars = Array.from({ length: 5 }, (_, index) => index + 1);

const bestSellers = PRODUCTS.filter((product) => product.featured).slice(0, 8);

// Hero slider: a handful of real SKUs with their prices, so the first screen
// already shows what the shop sells and what it costs.
const heroSlides = PRODUCTS.filter((product) => product.featured).slice(0, 5);

const useFilters = Array.from(
  new Map(PRODUCTS.map((product) => [product.use, { slug: product.use, label: product.useLabel }])).values(),
);
const typeFilters = Array.from(
  new Map(PRODUCTS.map((product) => [product.type, { slug: product.type, label: product.typeLabel }])).values(),
);
const originFilters = Array.from(
  new Map(
    PRODUCTS.map((product) => [product.origin, { slug: product.origin, label: product.originLabel }]),
  ).values(),
);
const countsByUse = Object.fromEntries(
  SHOP_NEEDS.map((need) => [need.slug, PRODUCTS.filter((product) => product.use === need.slug).length]),
);

const storeData = {
  announcement: ANNOUNCEMENT,
  freeShippingThreshold: FREE_SHIPPING_THRESHOLD,
  shippingFlat: SHIPPING_FLAT,
  taxRate: TAX_RATE,
  products: PRODUCTS,
  kits: KITS,
  accentColors: ACCENT_COLORS,
};
---

<html class="light" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Yoga Verde | Cosmética natural hecha en México</title>
    <meta
      content="Yoga Verde es cosmética natural hecha en México: desmaquillante, agua micelar, crema facial, crema corporal, mousse, bálsamo labial y velas de soya. Compra fácil desde móvil o desktop."
      name="description"
    />
    <meta content="Yoga Verde | Cosmética natural hecha en México" property="og:title" />
    <meta
      content="Cosmética natural hecha en México: cremas, desmaquillante, aceites capilares, bálsamo labial y velas de soya con almendra, coco, uva, lavanda y más."
      property="og:description"
    />
    <meta content="website" property="og:type" />
    <meta content="https://yoga-verde.srv1175749.hstgr.cloud/" property="og:url" />
    <meta
      content="https://yoga-verde.srv1175749.hstgr.cloud/yoga-verde/assets/brand/og-image.png"
      property="og:image"
    />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <link href="/yoga-verde/assets/brand/favicon-32.png" rel="icon" sizes="32x32" type="image/png" />
    <link href="/yoga-verde/assets/brand/favicon-180.png" rel="apple-touch-icon" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link href="https://yoga-verde.srv1175749.hstgr.cloud/" rel="canonical" />
  </head>
  <body class="bg-surface text-on-surface selection:bg-secondary/20 selection:text-primary">
    <script id="yoga-verde-data" is:inline set:html={JSON.stringify(storeData)} type="application/json"></script>

    <div class="min-h-screen bg-surface pb-28 md:pb-0">
      <div class="sticky top-0 z-[70]">
        <div class="bg-primary px-4 py-2 text-center text-[11px] font-semibold uppercase tracking-[0.22em] text-on-primary-container sm:text-xs">
          {ANNOUNCEMENT}
        </div>
        <header class="border-b border-white/10 bg-primary/95 backdrop-blur-xl">
          <nav class="mx-auto flex h-20 max-w-screen-2xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
              <a class="group inline-flex items-center rounded-2xl bg-surface-container-lowest/95 px-3 py-2 shadow-parchment ring-1 ring-black/5 transition group-hover:-translate-y-0.5 hover:-translate-y-0.5" href="#inicio">
                <img
                  alt="Yoga Verde — Cosmética natural"
                  class="h-11 w-auto sm:h-12"
                  height="1400"
                  src="/yoga-verde/assets/brand/logo-yoga-verde.svg"
                  width="1400"
                />
              </a>
            </div>

            <div class="hidden items-center gap-7 md:flex">
              <button class="nav-link" data-nav-link="inicio" data-scroll-to="inicio" type="button">
                Inicio
              </button>
              <button class="nav-link" data-nav-link="best-sellers" data-scroll-to="best-sellers" type="button">
                Best Sellers
              </button>
              <button class="nav-link" data-nav-link="catalogo" data-scroll-to="catalogo" type="button">
                Catálogo
              </button>
              <button class="nav-link" data-nav-link="kits" data-scroll-to="kits" type="button">
                Kits
              </button>
              <button class="nav-link" data-nav-link="testimonios" data-scroll-to="testimonios" type="button">
                Testimonios
              </button>
              <button class="nav-link" data-nav-link="contacto" data-scroll-to="contacto" type="button">
                Contacto
              </button>
            </div>

            <div class="flex items-center gap-3">
              <button
                aria-label="Buscar en el catálogo"
                class="hidden items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-on-primary-container transition hover:border-secondary/60 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35 lg:inline-flex"
                data-focus-search
                type="button"
              >
                <span class="material-symbols-outlined text-base">search</span>
                Buscar productos
              </button>
              <button
                aria-label="Abrir carrito"
                class="group relative inline-flex h-12 w-12 items-center justify-center rounded-full border border-outline-variant/50 bg-surface-container-lowest text-primary transition hover:-translate-y-0.5 hover:border-secondary/50 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                data-open-cart
                type="button"
              >
                <span class="material-symbols-outlined">shopping_cart</span>
                <span
                  class="absolute -right-1 -top-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-secondary px-1 text-[10px] font-bold text-white"
                  data-cart-count
                >
                  0
                </span>
              </button>
            </div>
          </nav>
        </header>
      </div>

      <main>
        <section class="relative overflow-hidden bg-surface" id="inicio">
          <div class="relative mx-auto grid max-w-screen-2xl gap-8 px-4 py-8 sm:px-6 sm:py-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,520px)] lg:items-center lg:gap-12 lg:px-8 lg:py-20">
            <div class="max-w-3xl">
              <div class="mb-4 flex items-end gap-3">
                <svg
                  aria-hidden="true"
                  class="pointer-events-none h-14 w-10 shrink-0 sm:h-24 sm:w-16"
                  data-sprig
                  viewBox="0 0 90 150"
                >
                  <path class="sprig-path" d="M20,145 C15,120 30,110 22,85 C17,68 28,60 24,45" style="--len:220" />
                  <path class="sprig-leaf" d="M22,100 C10,95 2,80 8,68 C14,78 20,90 22,100" style="--len:140" />
                  <path class="sprig-leaf" d="M23,75 C35,70 42,55 36,44 C30,54 25,66 23,75" style="--len:140" />
                  <path class="sprig-heart" d="M20,40 C18,37 14,37 14,40 C14,43 18,45 20,48 C22,45 26,43 26,40 C26,37 22,37 20,40 Z" />
                  <path class="sprig-heart" d="M15,29 C13,26.5 10,26.5 10,29 C10,31.5 13,33 15,35.5 C17,33 20,31.5 20,29 C20,26.5 17,26.5 15,29 Z" />
                  <path class="sprig-heart" d="M11,19 C9.5,17 7,17 7,19 C7,21 9.5,22.5 11,24.5 C12.5,22.5 15,21 15,19 C15,17 12.5,17 11,19 Z" />
                  <path class="sprig-heart" d="M8,10 C7,8.5 5,8.5 5,10 C5,11.5 7,12.5 8,14 C9,12.5 11,11.5 11,10 C11,8.5 9,8.5 8,10 Z" />
                </svg>
                <span class="inline-flex items-center gap-2 rounded-full border border-secondary/30 bg-secondary/15 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-secondary sm:text-xs">
                  <span class="material-symbols-outlined text-base">spa</span>
                  Cosmética natural hecha en México
                </span>
              </div>
              <h1 class="font-headline text-4xl leading-[1.02] text-primary sm:text-5xl lg:text-6xl">
                Piel, cabello y bienestar
                <span class="block font-semibold italic text-secondary">de origen natural</span>
              </h1>
              <p class="mt-6 max-w-2xl text-lg leading-relaxed text-on-surface-variant sm:text-xl">
                Desmaquillante, cremas, aceites capilares, bálsamo labial, velas de soya y más,
                cada uno con su ingrediente y su precio claro. Compra fácil desde móvil o
                desktop.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <button
                  class="inline-flex items-center justify-center gap-2 rounded-2xl bg-secondary px-5 py-3 text-sm font-semibold text-on-secondary sm:px-7 sm:py-4 sm:text-base transition hover:bg-[#c99433] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50"
                  data-scroll-to="catalogo"
                  type="button"
                >
                  Comprar ahora
                  <span class="material-symbols-outlined text-lg">south_east</span>
                </button>
                <button
                  class="inline-flex items-center justify-center gap-2 rounded-2xl border border-outline-variant/70 bg-surface-container-lowest px-5 py-3 text-sm font-semibold text-primary sm:px-7 sm:py-4 sm:text-base transition hover:border-secondary/50 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                  data-scroll-to="kits"
                  type="button"
                >
                  Ver kits
                  <span class="material-symbols-outlined text-lg">inventory_2</span>
                </button>
              </div>

              <div class="mt-7 grid grid-cols-3 gap-2 sm:flex sm:flex-wrap sm:gap-3">
                <div class="rounded-2xl bg-surface-container-lowest px-3 py-3 shadow-parchment sm:px-5 sm:py-4">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-on-surface-variant">
                    Productos
                  </p>
                  <p class="mt-2 font-headline text-2xl text-primary">{PRODUCTS.length}</p>
                </div>
                <div class="rounded-2xl bg-surface-container-lowest px-3 py-3 shadow-parchment sm:px-5 sm:py-4">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-on-surface-variant">
                    Kits curados
                  </p>
                  <p class="mt-2 font-headline text-2xl text-primary">{KITS.length}</p>
                </div>
                <div class="rounded-2xl bg-surface-container-lowest px-3 py-3 shadow-parchment sm:px-5 sm:py-4">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-on-surface-variant">
                    Envío gratis
                  </p>
                  <p class="mt-2 font-headline text-2xl text-primary">
                    {formatMoney(FREE_SHIPPING_THRESHOLD)}
                  </p>
                </div>
              </div>
            </div>

            <div class="relative">
              <img
                alt=""
                aria-hidden="true"
                class="brand-stamp absolute -left-5 -top-5 z-20 h-20 w-20 rounded-full bg-surface-container-lowest object-contain p-2 shadow-float sm:-left-7 sm:-top-7 sm:h-24 sm:w-24"
                data-stamp
                src="/yoga-verde/assets/brand/logo-monogram.png"
              />
              <div class="card-grain relative overflow-hidden rounded-[36px] bg-surface-container-lowest p-4 shadow-float sm:p-6">
                <div class="relative" data-hero-slider>
                  {heroSlides.map((product, index) => (
                    <div
                      class:list={["hero-slide", index === 0 && "is-active"]}
                      data-hero-slide={index}
                    >
                      <span class="specimen-label absolute right-4 top-4 z-10 rounded-full bg-primary/90 px-3 py-1 text-[10px] font-bold uppercase text-on-primary">
                        {product.typeLabel}
                      </span>
                      <img
                        alt={`${product.name} Yoga Verde con ${product.scent}`}
                        class="aspect-[4/5] w-full rounded-[30px] bg-surface-container-lowest object-contain p-6"
                        loading={index === 0 ? "eager" : "lazy"}
                        src={product.image}
                      />
                      <div class="flex items-end justify-between gap-4 px-2 pb-1 pt-4">
                        <div class="min-w-0">
                          <h2 class="truncate font-headline text-xl text-primary">{product.name}</h2>
                          <p class="mt-1 truncate text-sm text-on-surface-variant">{product.scent}</p>
                        </div>
                        <div class="flex shrink-0 flex-col items-end gap-2">
                          <span class="price text-2xl">{formatMoney(product.price)}</span>
                          <button
                            class="inline-flex items-center gap-1.5 rounded-full bg-secondary px-4 py-2 text-xs font-bold text-on-secondary transition hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50"
                            data-add-item={product.id}
                            type="button"
                          >
                            Añadir
                            <span class="material-symbols-outlined text-sm">add_shopping_cart</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="mt-3 flex items-center justify-center gap-2">
                  {heroSlides.map((product, index) => (
                    <button
                      aria-label={`Ver ${product.name}`}
                      class:list={["hero-dot", index === 0 && "is-active"]}
                      data-hero-dot={index}
                      type="button"
                    />
                  ))}
                </div>
              </div>
              <div class="absolute -right-2 top-6 rounded-[28px] bg-tertiary-container px-5 py-4 text-on-tertiary-container shadow-line sm:-right-8">
                <p class="text-[11px] uppercase tracking-[0.22em] text-on-tertiary-container/80">
                  Declaración de naturalidad
                </p>
                <p class="mt-2 font-headline text-2xl text-on-tertiary-container">Vegano y cruelty free</p>
                <p class="mt-2 max-w-[200px] text-sm leading-6 text-on-tertiary-container/90">
                  Formulado sin sulfatos ni parabenos, como indica cada etiqueta.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="reveal mx-auto max-w-screen-2xl px-4 py-8 sm:px-6 lg:px-8">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
            {BENEFIT_ITEMS.map((benefit) => (
              <article class="rounded-[28px] bg-surface-container-lowest p-5 shadow-parchment">
                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/8 text-primary">
                  <span class="material-symbols-outlined">{benefit.icon}</span>
                </div>
                <h2 class="mt-4 font-headline text-2xl text-primary">{benefit.title}</h2>
                <p class="mt-2 text-sm leading-7 text-on-surface-variant">{benefit.copy}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="reveal mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8" id="best-sellers">
          <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
              <p class="specimen-label text-xs font-semibold uppercase tracking-[0.22em] text-secondary">
                Best Sellers
              </p>
              <h2 class="mt-3 font-headline text-4xl text-primary">Lo más pedido esta temporada</h2>
              <p class="mt-4 text-lg leading-8 text-on-surface-variant">
                Los productos que más se repiten en pedidos: limpieza facial, hidratación
                corporal y velas de soya listos para agregar al carrito.
              </p>
            </div>
            <button
              class="inline-flex items-center gap-2 rounded-full border border-outline-variant/60 bg-surface-container-lowest px-5 py-3 text-sm font-semibold text-primary transition hover:border-secondary/40 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
              data-scroll-to="catalogo"
              type="button"
            >
              Ver catálogo completo
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </button>
          </div>

          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
            {bestSellers.map((product) => (
              <article
                class="group overflow-hidden rounded-[30px] bg-surface-container-lowest shadow-parchment transition-transform hover:-translate-y-1"
                style={`--accent: ${accentOf(product)}`}
              >
                <div class="relative overflow-hidden bg-surface-container-low p-4">
                  <span class="absolute left-4 top-4 z-10 rounded-full bg-surface px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em] text-primary">
                    {product.badge}
                  </span>
                  <img
                    alt={`${product.name} ${product.scent}`}
                    class="aspect-[5/4] w-full rounded-[24px] bg-surface-container-lowest object-contain p-5 transition duration-500 group-hover:scale-105"
                    src={product.image}
                  />
                </div>
                <div class="p-6">
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                      <p class="text-[11px] uppercase tracking-[0.22em] text-on-surface-variant">
                        {product.scent}
                      </p>
                      <h3 class="mt-2 font-headline text-4xl leading-none text-primary">{product.name}</h3>
                    </div>
                    <span class="price shrink-0 text-xl">{formatMoney(product.price)}</span>
                  </div>
                  <div class="mt-4 flex items-center gap-3 text-sm text-on-surface-variant">
                    <div class="flex items-center gap-1 text-[var(--accent)]">
                      {stars.map((star) => (
                        <span aria-hidden="true">{star <= Math.round(product.rating) ? "★" : "☆"}</span>
                      ))}
                    </div>
                    <span>{product.rating.toFixed(1)} · {product.reviewsCount} reseñas</span>
                  </div>
                  <p class="mt-4 text-sm italic leading-7 text-on-surface-variant">{product.short}</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    <span class="accent-dot rounded-full bg-surface-container-low px-3 py-2 text-xs font-semibold text-primary">
                      {product.useLabel}
                    </span>
                    <span class="rounded-full bg-surface-container-low px-3 py-2 text-xs font-semibold text-on-surface-variant">
                      {product.typeLabel}
                    </span>
                  </div>
                  <div class="mt-6 flex items-center justify-between gap-3 border-t border-outline-variant/40 pt-5">
                    <button
                      class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition hover:text-secondary focus-visible:outline-none"
                      data-open-detail={product.id}
                      type="button"
                    >
                      <span class="material-symbols-outlined text-base">auto_stories</span>
                      Ver detalle
                    </button>
                    <button
                      class="inline-flex items-center gap-2 rounded-2xl bg-primary px-4 py-3 text-sm font-semibold text-on-primary transition hover:bg-primary-container focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                      data-add-item={product.id}
                      type="button"
                    >
                      Añadir al carrito
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="reveal relative overflow-hidden bg-surface py-16" id="ingrediente-en-foco">
          <div class="relative mx-auto grid max-w-screen-2xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(320px,460px)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:px-8">
            <div class="relative mx-auto w-full max-w-md lg:mx-0">
              <div class="absolute -inset-6 -z-10 rounded-full bg-tertiary/20 blur-2xl"></div>
              <div class="card-grain relative overflow-hidden rounded-[999px] bg-surface-container-lowest p-8 shadow-float sm:p-10">
                <img
                  alt="Mascarilla facial de arcilla verde y té verde Yoga Verde"
                  class="aspect-square w-full rounded-full bg-surface-container-lowest object-contain"
                  src="/yoga-verde/assets/products/mascarilla-arcilla-te-verde.jpg"
                />
              </div>
              <span class="specimen-label absolute left-2 top-4 rounded-full bg-tertiary px-4 py-2 text-[10px] font-bold uppercase text-on-tertiary-container shadow-line sm:left-0">
                Favorita de clientas
              </span>
              <div class="absolute -right-2 bottom-6 max-w-[180px] rounded-[24px] bg-surface-container-lowest p-4 text-center shadow-parchment sm:-right-6">
                <div class="flex items-center justify-center gap-1 text-tertiary">
                  {stars.map((star) => (
                    <span aria-hidden="true">{star <= 5 ? "★" : "☆"}</span>
                  ))}
                </div>
                <p class="mt-2 text-xs leading-5 text-on-surface-variant">4.8 · 31 reseñas reales</p>
              </div>
            </div>

            <div class="max-w-2xl">
              <p class="specimen-label text-xs font-semibold uppercase tracking-[0.22em] text-tertiary">
                Ingrediente en foco
              </p>
              <h2 class="mt-3 font-headline text-4xl leading-[1.05] text-primary">
                Arcilla verde
                <span class="block font-semibold italic text-tertiary">y té verde</span>
              </h2>
              <p class="mt-5 max-w-xl text-lg leading-8 text-on-surface-variant">
                Mascarilla lista para usar, pensada para piel mixta o con tendencia grasa: la
                arcilla absorbe el exceso de sebo mientras el té verde aporta su antioxidante
                natural.
              </p>

              <ul class="mt-7 space-y-3">
                <li class="flex items-start gap-3 text-on-surface-variant">
                  <span class="material-symbols-outlined mt-0.5 text-tertiary">check_circle</span>
                  <span>Arcilla verde para absorber el exceso de grasa.</span>
                </li>
                <li class="flex items-start gap-3 text-on-surface-variant">
                  <span class="material-symbols-outlined mt-0.5 text-tertiary">check_circle</span>
                  <span>Té verde como antioxidante natural.</span>
                </li>
                <li class="flex items-start gap-3 text-on-surface-variant">
                  <span class="material-symbols-outlined mt-0.5 text-tertiary">check_circle</span>
                  <span>Lata metálica de 60 g, rinde varias aplicaciones.</span>
                </li>
              </ul>

              <div class="mt-7 rounded-[24px] border border-outline-variant/50 bg-surface-container-lowest p-5">
