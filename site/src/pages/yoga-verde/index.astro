---
import {
  ACCENT_COLORS,
  ANNOUNCEMENT,
  FREE_SHIPPING_THRESHOLD,
  KITS,
  PRODUCTS,
  SHIPPING_FLAT,
  TAX_RATE,
} from "../../data/yoga-verde-store";

const accentOf = (item: { use?: string }) => ACCENT_COLORS[item.use as keyof typeof ACCENT_COLORS] || ACCENT_COLORS.terracota;
import "../../styles/yoga-verde.css";

const money = new Intl.NumberFormat("es-MX", {
  style: "currency",
  currency: "MXN",
  maximumFractionDigits: 0,
});

const formatMoney = (value: number) => money.format(value);

const bestSellers = PRODUCTS.filter((product) => product.featured).slice(0, 8);

// Solo estos SKUs tienen fotografía real del envase; el resto de los assets son
// la etiqueta plana renderizada, que en un banner se leería como arte, no como
// producto. El hero se compone únicamente con los primeros.
const REAL_PHOTO_IDS = [
  "desmaquillante-almendra-dulce",
  "crema-facial-chabacano",
  "agua-micelar-manzanilla",
  "crema-corporal-leche-de-coco",
  "mousse-corporal-uva",
  "vela-soya-vainilla",
  "contorno-de-ojos-lavanda",
  "balsamo-labial-coco-menta",
  "vela-soya-bergamota",
];

const heroSlides = REAL_PHOTO_IDS.map((id) =>
  PRODUCTS.find((product) => product.id === id),
).filter(Boolean).slice(0, 5) as typeof PRODUCTS;

// Las piezas reales que componen cada kit (ver `items` en yoga-verde-store.js),
// para poder mostrarlas todas en la tarjeta en vez de una sola foto.
const productById = new Map(PRODUCTS.map((product) => [product.id, product]));
const kitItems = (kit: { items?: string[] }) =>
  (kit.items || []).map((id) => productById.get(id)).filter(Boolean) as typeof PRODUCTS;

// Fuente de verdad única de la navegación. El orden aquí ES el orden comercial
// de la página, y lo consumen el header, la barra inferior móvil, el footer y
// el scrollspy, de modo que no puedan desincronizarse entre sí.
const NAV_ITEMS = [
  { id: "inicio", label: "Inicio", icon: "home", inTabBar: true },
  { id: "best-sellers", label: "Selección", icon: "auto_awesome", inTabBar: false },
  { id: "catalogo", label: "Catálogo", icon: "storefront", inTabBar: true },
  { id: "kits", label: "Kits", icon: "inventory_2", inTabBar: true },
  { id: "contacto", label: "Contacto", icon: "mail", inTabBar: false },
];
const tabBarItems = NAV_ITEMS.filter((item) => item.inTabBar);

const useFilters = Array.from(
  new Map(PRODUCTS.map((product) => [product.use, { slug: product.use, label: product.useLabel }])).values(),
);
const typeFilters = Array.from(
  new Map(PRODUCTS.map((product) => [product.type, { slug: product.type, label: product.typeLabel }])).values(),
);

const storeData = {
  announcement: ANNOUNCEMENT,
  freeShippingThreshold: FREE_SHIPPING_THRESHOLD,
  shippingFlat: SHIPPING_FLAT,
  taxRate: TAX_RATE,
  products: PRODUCTS,
  kits: KITS,
  accentColors: ACCENT_COLORS,
};
---

<html class="light" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Yoga Verde | Cosmética natural hecha en México</title>
    <meta
      content="Yoga Verde es cosmética natural hecha en México: desmaquillante, agua micelar, crema facial, crema corporal, mousse, bálsamo labial y velas de soya. Compra fácil desde móvil o desktop."
      name="description"
    />
    <meta content="Yoga Verde | Cosmética natural hecha en México" property="og:title" />
    <meta
      content="Cosmética natural hecha en México: cremas, desmaquillante, aceites capilares, bálsamo labial y velas de soya con almendra, coco, uva, lavanda y más."
      property="og:description"
    />
    <meta content="website" property="og:type" />
    <meta content="https://yoga-verde.srv1175749.hstgr.cloud/" property="og:url" />
    <meta
      content="https://yoga-verde.srv1175749.hstgr.cloud/yoga-verde/assets/brand/og-image.png"
      property="og:image"
    />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <link href="/yoga-verde/assets/brand/favicon-32.png" rel="icon" sizes="32x32" type="image/png" />
    <link href="/yoga-verde/assets/brand/favicon-180.png" rel="apple-touch-icon" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link href="https://yoga-verde.srv1175749.hstgr.cloud/" rel="canonical" />
  </head>
  <body class="bg-surface text-on-surface selection:bg-secondary/20 selection:text-primary">
    <script id="yoga-verde-data" is:inline set:html={JSON.stringify(storeData)} type="application/json"></script>

    <div class="min-h-screen bg-surface pb-28 md:pb-0" data-page-content>
      <div class="sticky top-0 z-[70]">
        <div class="bg-primary px-4 py-2 text-center text-[11px] font-semibold uppercase tracking-[0.22em] text-on-primary-container sm:text-xs">
          {ANNOUNCEMENT}
        </div>
        <header class="border-b border-white/10 bg-primary/95 backdrop-blur-xl">
          <nav class="mx-auto flex h-20 max-w-screen-2xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
              <a class="inline-flex items-center rounded-2xl bg-surface-container-lowest px-3.5 py-2.5 shadow-parchment transition hover:-translate-y-0.5" href="#inicio">
                <img
                  alt="Yoga Verde — Cosmética natural"
                  class="h-14 w-auto sm:h-16"
                  height="1400"
                  src="/yoga-verde/assets/brand/logo-yoga-verde.svg"
                  width="1400"
                />
              </a>
            </div>

            <div class="hidden items-center gap-7 md:flex">
              {NAV_ITEMS.map((item) => (
                <button class="nav-link" data-nav-link={item.id} data-scroll-to={item.id} type="button">
                  {item.label}
                </button>
              ))}
            </div>

            <div class="flex items-center gap-3">
              <button
                aria-label="Buscar en el catálogo"
                class="hidden items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-on-primary-container transition hover:border-secondary/60 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35 lg:inline-flex"
                data-focus-search
                type="button"
              >
                <span class="material-symbols-outlined text-base">search</span>
                Buscar productos
              </button>
              <button
                aria-label="Abrir carrito"
                class="group relative inline-flex h-12 w-12 items-center justify-center rounded-full border border-outline-variant/50 bg-surface-container-lowest text-primary transition hover:-translate-y-0.5 hover:border-secondary/50 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                data-open-cart
                type="button"
              >
                <span class="material-symbols-outlined">shopping_cart</span>
                <span
                  class="absolute -right-1 -top-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-secondary px-1 text-[10px] font-bold text-white"
                  data-cart-count
                >
                  0
                </span>
              </button>
            </div>
          </nav>
        </header>
      </div>

      <main>
        <!-- Hero mobile-first: marca, un slogan de una línea y producto real de
             inmediato. Sin párrafo institucional, sin estadísticas y sin CTA
             genérico: la primera decisión que ofrecemos es sobre un producto. -->
        <section class="bg-surface" id="inicio">
          <div class="mx-auto w-full max-w-screen-2xl px-4 pb-6 pt-7 sm:px-6 sm:pb-8 sm:pt-10 lg:grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-16 lg:px-8 lg:py-16">
            <div class="lg:pb-6">
              <img
                alt="Yoga Verde"
                class="h-16 w-auto max-w-full sm:h-20 lg:h-28"
                height="1400"
                src="/yoga-verde/assets/brand/logo-yoga-verde.svg"
                width="1400"
              />
              <p class="mt-4 max-w-[22ch] font-headline text-[clamp(1.5rem,7vw,2rem)] leading-[1.15] text-primary lg:mt-6 lg:max-w-[16ch] lg:text-[clamp(2.25rem,3.2vw,3.25rem)]">
                Piel, cabello y bienestar
                <span class="italic text-secondary">de origen natural</span>
              </p>
            </div>

            <div class="mt-6 lg:mt-0">
              <div class="relative overflow-hidden rounded-[28px] bg-surface-container-lowest p-3 shadow-parchment sm:rounded-[32px] sm:p-4">
                <div data-hero-slider>
                  {heroSlides.map((product, index) => (
                    <article
                      class:list={["hero-slide", index === 0 && "is-active"]}
                      data-hero-slide={index}
                    >
                      <img
                        alt={`${product.name}, ${product.scent}`}
                        class="aspect-square w-full max-w-full rounded-[22px] bg-surface-container-lowest object-contain"
                        decoding={index === 0 ? "sync" : "async"}
                        loading={index === 0 ? "eager" : "lazy"}
                        src={product.image}
                      />
                      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3 px-1 pb-1 pt-4">
                        <div class="min-w-0 flex-1 basis-[9rem]">
                          <h2 class="product-name font-headline text-lg leading-snug text-primary sm:text-xl">
                            {product.name}
                          </h2>
                          <p class="mt-0.5 text-sm text-on-surface-variant">{product.scent}</p>
                        </div>
                        <div class="flex min-w-0 shrink-0 items-center gap-3">
                          <span class="price text-xl sm:text-2xl">{formatMoney(product.price)}</span>
                          <button
                            class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-full bg-secondary px-4 text-xs font-bold text-on-secondary transition hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50"
                            data-add-item={product.id}
                            type="button"
                          >
                            Añadir
                            <span aria-hidden="true" class="material-symbols-outlined text-sm">add_shopping_cart</span>
                          </button>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>

                <div class="mt-3 flex items-center justify-center gap-2">
                  {heroSlides.map((product, index) => (
                    <button
                      aria-label={`Ver ${product.name}`}
                      class:list={["hero-dot", index === 0 && "is-active"]}
                      data-hero-dot={index}
                      type="button"
                    />
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>


        <section class="reveal mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8" id="best-sellers">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-2 sm:mb-6">
            <div class="min-w-0">
              <p class="specimen-label text-xs font-semibold uppercase tracking-[0.22em] text-secondary">
                Selección
              </p>
              <h2 class="mt-2 font-headline text-2xl text-primary sm:text-3xl">Para empezar</h2>
            </div>
            <button
              class="inline-flex min-h-11 shrink-0 items-center gap-1.5 text-sm font-semibold text-primary transition hover:text-secondary focus-visible:outline-none"
              data-scroll-to="catalogo"
              type="button"
            >
              Ver todo
              <span aria-hidden="true" class="material-symbols-outlined text-base">arrow_forward</span>
            </button>
          </div>

          <!-- En móvil es un carril horizontal con snap: apilar 8 tarjetas dejaba
               ~6.800px de scroll antes del catálogo. En md+ vuelve a ser grid. -->
          <div class="hide-scrollbar -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:-mx-6 sm:px-6 md:mx-0 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 xl:grid-cols-4">
            {bestSellers.map((product) => (
              <article
                class="group w-[78vw] max-w-[19rem] shrink-0 snap-start overflow-hidden rounded-[30px] md:w-auto md:max-w-none md:shrink bg-surface-container-lowest shadow-parchment transition-transform hover:-translate-y-1"
                style={`--accent: ${accentOf(product)}`}
              >
                <div class="relative overflow-hidden bg-surface-container-low p-4">
                  {product.badge && (
                    <span class="absolute left-4 top-4 z-10 rounded-full bg-surface px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em] text-primary">
                      {product.badge}
                    </span>
                  )}
                  <img
                    alt={`${product.name} ${product.scent}`}
                    class="aspect-[4/3] product-media w-full rounded-[24px] bg-surface-container-lowest p-1 transition duration-500 group-hover:scale-105"
                    src={product.image}
                  />
                </div>
                <div class="p-5 sm:p-6">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-on-surface-variant">
                    {product.typeLabel}
                  </p>
                  <h3 class="product-name mt-1.5 font-headline text-xl leading-snug text-primary">{product.name}</h3>
                  <p class="mt-0.5 text-sm text-on-surface-variant">{product.scent}</p>
                  <p class="mt-3 text-sm leading-6 text-on-surface-variant">{product.short}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    <span class="accent-dot rounded-full bg-surface-container-low px-3 py-1.5 text-xs font-semibold text-primary">
                      {product.useLabel}
                    </span>
                    {product.size && (
                      <span class="rounded-full bg-surface-container-low px-3 py-1.5 text-xs font-semibold text-on-surface-variant">
                        {product.size}
                      </span>
                    )}
                  </div>
                  <div class="mt-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-outline-variant/40 pt-4">
                    <span class="price text-xl">{formatMoney(product.price)}</span>
                    <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2">
                      <button
                        class="inline-flex min-h-11 shrink-0 items-center gap-1.5 text-sm font-semibold text-primary transition hover:text-secondary focus-visible:outline-none"
                        data-open-detail={product.id}
                        type="button"
                      >
                        Ver detalle
                      </button>
                      <button
                        aria-label={`Añadir ${product.name} al carrito`}
                        class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-2xl bg-primary px-4 text-sm font-semibold text-on-primary transition hover:bg-primary-container focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                        data-add-item={product.id}
                        type="button"
                      >
                        Añadir
                      </button>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        

        <section class="relative overflow-hidden bg-surface px-4 py-16 sm:px-6 lg:px-8" id="catalogo">
          <div class="relative mx-auto max-w-screen-2xl">
          <div class="mb-8 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div class="min-w-0">
              <h2 class="font-headline text-2xl text-primary sm:text-3xl">Catálogo completo</h2>
              <p class="mt-1 text-sm text-on-surface-variant">
                <span data-product-count>{PRODUCTS.length}</span> productos
              </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <div class="flex w-full min-w-[280px] items-center gap-3 rounded-full border border-outline-variant/60 bg-surface-container-lowest px-4 py-3 shadow-parchment">
                <span class="material-symbols-outlined text-on-surface-variant">search</span>
                <input
                  aria-label="Buscar productos"
                  class="w-full border-none bg-transparent p-0 text-sm text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:ring-0"
                  data-search-input
                  placeholder="Buscar almendra, crema facial, vela de soya..."
                  type="search"
                />
              </div>
              <button
                aria-label="Abrir filtros"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-outline-variant/60 bg-surface-container-lowest px-5 py-3 text-sm font-semibold text-primary transition hover:border-secondary/40 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35 xl:hidden"
                data-open-filters
                type="button"
              >
                <span class="material-symbols-outlined text-base">tune</span>
                Filtros
              </button>
            </div>
          </div>

          <div class="grid gap-8 xl:grid-cols-[300px_minmax(0,1fr)]">
            <div class="pointer-events-none fixed inset-0 z-[72] bg-primary/25 opacity-0 transition xl:hidden" data-filters-overlay></div>
            <aside
              class="hide-scrollbar fixed inset-y-0 left-0 z-[80] w-[88vw] max-w-sm -translate-x-full overflow-y-auto bg-surface-container-low p-6 shadow-float transition duration-300 xl:sticky xl:top-28 xl:z-auto xl:w-auto xl:max-w-none xl:translate-x-0 xl:overflow-visible xl:rounded-[32px] xl:border xl:border-outline-variant/45 xl:bg-surface-container-low xl:shadow-parchment"
              data-filters-drawer
            >
              <div class="mb-8 flex items-center justify-between xl:hidden">
                <div>
                  <p class="specimen-label text-xs font-semibold uppercase tracking-[0.22em] text-secondary">
                    Filtros
                  </p>
                  <h3 class="mt-2 font-headline text-3xl text-primary">Compra por afinidad</h3>
                </div>
                <button
                  aria-label="Cerrar filtros"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-outline-variant/60 text-primary transition hover:border-secondary/40 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                  data-close-filters
                  type="button"
                >
                  <span class="material-symbols-outlined">close</span>
                </button>
              </div>

              <div class="space-y-8">
                <div>
                  <h3 class="font-headline text-2xl text-primary">Familia de aroma</h3>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {useFilters.map((useFilter) => (
                      <button
                        aria-pressed="false"
                        class="rounded-full bg-surface-container-highest px-4 py-2 text-sm font-medium text-on-surface-variant transition hover:bg-tertiary-container hover:text-on-tertiary-container focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                        data-filter-use={useFilter.slug}
                        type="button"
                      >
                        {useFilter.label}
                      </button>
                    ))}
                  </div>
                </div>

                <div>
                  <h3 class="font-headline text-2xl text-primary">Categoría</h3>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {typeFilters.map((typeFilter) => (
                      <button
                        aria-pressed="false"
                        class="rounded-full bg-surface-container-highest px-4 py-2 text-sm font-medium text-on-surface-variant transition hover:bg-tertiary-container hover:text-on-tertiary-container focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                        data-filter-type={typeFilter.slug}
                        type="button"
                      >
                        {typeFilter.label}
                      </button>
                    ))}
                  </div>
                </div>



                <button
                  class="w-full rounded-2xl border border-outline-variant/70 px-4 py-3 text-sm font-semibold text-primary transition hover:border-secondary/40 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                  data-clear-filters
                  type="button"
                >
                  Limpiar filtros
                </button>
              </div>
            </aside>

            <div class="min-w-0">
              <div class="rounded-[32px] bg-surface-container-low p-6 shadow-parchment">
                <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
                  <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-on-surface-variant">
                      <span data-product-count-filtered>{PRODUCTS.length}</span> piezas visibles
                    </p>
                    <p class="mt-2 text-sm leading-7 text-on-surface-variant">
                      Filtra por aroma, categoría o tamaño de envase.
                    </p>
                    <div class="mt-4 flex flex-wrap gap-2" data-active-filters></div>
                  </div>
                  <div class="flex flex-wrap gap-3">
                    <button
                      class="inline-flex items-center gap-2 rounded-full border border-outline-variant/60 bg-surface-container-lowest px-4 py-2 text-sm font-semibold text-primary transition hover:border-secondary/40 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                      data-open-cart
                      type="button"
                    >
                      Ver carrito
                      <span class="material-symbols-outlined text-base">shopping_cart</span>
                    </button>
                    <button
                      class="inline-flex items-center gap-2 rounded-full border border-outline-variant/60 bg-surface-container-lowest px-4 py-2 text-sm font-semibold text-primary transition hover:border-secondary/40 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                      data-scroll-to="kits"
                      type="button"
                    >
                      Ver kits
                      <span class="material-symbols-outlined text-base">inventory_2</span>
                    </button>
                  </div>
                </div>
              </div>

              <div class="mt-8 grid gap-6 md:grid-cols-2 2xl:grid-cols-3" data-products-grid>
                {PRODUCTS.map((product) => (
                  <article
                    class="group overflow-hidden rounded-[30px] bg-surface-container-lowest shadow-parchment transition-transform hover:-translate-y-1"
                    style={`--accent: ${accentOf(product)}`}
                  >
                    <div class="relative overflow-hidden bg-surface-container-low p-4">
                      <span class="absolute left-4 top-4 z-10 rounded-full bg-surface px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em] text-primary">
                        {product.badge}
                      </span>
                      <img
                        alt={`${product.name} ${product.scent}`}
                        class="aspect-[4/3] product-media w-full rounded-[24px] bg-surface-container-lowest p-1 transition duration-500 group-hover:scale-105"
                        src={product.image}
                      />
                    </div>
                    <div class="p-6">
                      <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                          <p class="text-[11px] uppercase tracking-[0.22em] text-on-surface-variant">
                            {product.typeLabel} · {product.scent}
                          </p>
                          <h3 class="product-name mt-1.5 font-headline text-xl leading-snug text-primary">
                            {product.name}
                          </h3>
                        </div>
                        <span class="price shrink-0 text-xl">{formatMoney(product.price)}</span>
                      </div>
                      <p class="mt-4 min-h-[84px] text-sm italic leading-7 text-on-surface-variant">{product.short}</p>
                      <div class="mt-4 flex flex-wrap gap-2">
