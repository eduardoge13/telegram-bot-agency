---
import ProductCard from "../../components/yoga-verde/ProductCard.astro";
import YogaVerdeLayout from "../../components/yoga-verde/YogaVerdeLayout.astro";
import {
  campaignMedia,
  collections,
  featuredProducts,
  formatMoney,
  productById,
  productUrl,
} from "../../lib/yoga-verde";

const heroProduct = productById.get("cera-cabello-ceja")!;
const heroMedia = campaignMedia[heroProduct.id];
const homeProducts = featuredProducts.filter((product) => product.id !== heroProduct.id).slice(0, 3);
---

<YogaVerdeLayout
  activePage="inicio"
  canonicalPath="/yoga-verde"
  description="Descubre Yoga Verde: cosmética natural hecha en México para rostro, cuerpo, cabello y hogar, con precios claros y compra sencilla."
  title="Yoga Verde | Cosmética natural hecha en México"
>
  <section class="yv-home-hero">
    <div class="yv-home-hero__copy">
      <div class="yv-home-hero__brand">
        <p class="yv-edition">Catálogo Yoga Verde · 2026</p>
        <img alt="Yoga Verde — Cosmética natural" class="yv-home-hero__logo" height="1400" src="/yoga-verde/assets/brand/logo-yoga-verde.svg" width="1400" />
      </div>
      <div class="yv-home-hero__product-copy">
        <p class="yv-eyebrow">Producto protagonista</p>
        <h1>{heroProduct.name}</h1>
        <p class="yv-home-hero__scent">{heroProduct.scent}</p>
        <p class="yv-home-hero__summary">{heroProduct.short}</p>
        <p class="price yv-home-hero__price">{formatMoney(heroProduct.price)}</p>
        <div class="yv-home-hero__actions">
          <a class="yv-primary-link" href={productUrl(heroProduct)}>Conocer el producto</a>
          <a class="yv-secondary-link" href="/yoga-verde/catalogo">Ver catálogo completo</a>
        </div>
      </div>
    </div>
    <a class="yv-home-hero__visual" href={productUrl(heroProduct)}>
      <img
        alt={`${heroProduct.name} con cera de abeja y romero`}
        fetchpriority="high"
        height={heroMedia.height}
        sizes="(max-width: 767px) 100vw, 58vw"
        src={heroMedia.src}
        srcset={`${heroMedia.src.replace(".webp", "-800.webp")} 800w, ${heroMedia.src} ${heroMedia.width}w`}
        width={heroMedia.width}
      />
      <span class="yv-home-hero__visual-note">Cera de abeja · Romero · 70 g</span>
    </a>
  </section>

  <nav aria-label="Comprar por colección" class="yv-collection-nav">
    <div class="yv-section-heading">
      <div><p class="yv-eyebrow">Encuentra tu ritual</p><h2>Comprar por colección</h2></div>
      <a class="yv-text-link" href="/yoga-verde/catalogo">Ver todos los productos →</a>
    </div>
    <div class="yv-collection-nav__grid">
      {collections.map((collection) => {
        const product = productById.get(collection.imageId)!;
        const media = campaignMedia[collection.imageId];
        return (
          <a class={`yv-collection-tile is-${collection.accent}`} href={`/yoga-verde/colecciones/${collection.slug}`}>
            <img alt={`${collection.label}: ${product.name}`} loading="lazy" src={media?.src || product.image} />
            <span><small>{product.name}</small><strong>{collection.label}</strong><em>Explorar →</em></span>
          </a>
        );
      })}
    </div>
  </nav>

  <section class="yv-home-selection">
    <div class="yv-section-heading">
      <div><p class="yv-eyebrow">Selección del catálogo</p><h2>Tres esenciales con una historia visual propia</h2></div>
      <p>Manzanilla, mango y coco: fórmulas fáciles de entender, precios visibles y fotografías reales del catálogo.</p>
    </div>
    <div class="yv-product-grid yv-product-grid--home">
      {homeProducts.map((product) => (
        <ProductCard editorial imageSrc={campaignMedia[product.id]?.src || product.image} priority product={product} />
      ))}
    </div>
  </section>

  <section class="yv-home-signoff">
    <div>
      <p class="yv-eyebrow">Compra a tu manera</p>
      <h2>Menos desplazamiento.<br />Más claridad.</h2>
    </div>
    <div class="yv-home-signoff__links">
      <a href="/yoga-verde/catalogo"><strong>27 productos</strong><span>Catálogo completo →</span></a>
      <a href="/yoga-verde/kits"><strong>6 combinaciones</strong><span>Explorar kits →</span></a>
    </div>
  </section>
</YogaVerdeLayout>
