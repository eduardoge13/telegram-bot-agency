---
import {
  ACCENT_COLORS,
  ANNOUNCEMENT,
  FREE_SHIPPING_THRESHOLD,
  KITS,
  PRODUCTS,
  SHIPPING_FLAT,
  TAX_RATE,
} from "../../data/yoga-verde-store";

const accentOf = (item: { use?: string }) => ACCENT_COLORS[item.use as keyof typeof ACCENT_COLORS] || ACCENT_COLORS.terracota;
import "../../styles/yoga-verde.css";

const money = new Intl.NumberFormat("es-MX", {
  style: "currency",
  currency: "MXN",
  maximumFractionDigits: 0,
});

const formatMoney = (value: number) => money.format(value);

const displayImage = (path: string) =>
  path.replace("/products/", "/products/display/").replace(/\.jpg$/i, ".webp");

const displayProducts = PRODUCTS.map((product) => ({
  ...product,
  image: displayImage(product.image),
}));

const displayKits = KITS.map((kit) => ({
  ...kit,
  image: displayImage(kit.image),
}));

const essentialIds = [
  "agua-micelar-manzanilla",
  "crema-facial-chabacano",
  "contorno-de-ojos-lavanda",
];
const essentialProducts = essentialIds
  .map((id) => displayProducts.find((product) => product.id === id))
  .filter(Boolean) as typeof displayProducts;
const featuredKit = displayKits.find((kit) => kit.id === "kit-ritual-facial") || displayKits[0];

// Solo estos SKUs tienen fotografía real del envase; el resto de los assets son
// la etiqueta plana renderizada, que en un banner se leería como arte, no como
// producto. El hero se compone únicamente con los primeros.
const REAL_PHOTO_IDS = [
  "desmaquillante-almendra-dulce",
  "crema-facial-chabacano",
  "agua-micelar-manzanilla",
  "crema-corporal-leche-de-coco",
  "mousse-corporal-uva",
  "vela-soya-vainilla",
  "contorno-de-ojos-lavanda",
  "balsamo-labial-coco-menta",
  "vela-soya-bergamota",
];

const heroSlides = REAL_PHOTO_IDS.map((id) =>
  displayProducts.find((product) => product.id === id),
).filter(Boolean).slice(0, 5) as typeof displayProducts;

// Las piezas reales que componen cada kit (ver `items` en yoga-verde-store.js),
// para poder mostrarlas todas en la tarjeta en vez de una sola foto.
const productById = new Map(displayProducts.map((product) => [product.id, product]));
const kitItems = (kit: { items?: string[] }) =>
  (kit.items || []).map((id) => productById.get(id)).filter(Boolean) as typeof displayProducts;

// Fuente de verdad única de la navegación. El orden aquí ES el orden comercial
// de la página, y lo consumen el header, el menú móvil, el footer y el
// scrollspy, de modo que no puedan desincronizarse entre sí.
const NAV_ITEMS = [
  { id: "inicio", label: "Inicio" },
  { id: "best-sellers", label: "Selección" },
  { id: "catalogo", label: "Catálogo" },
  { id: "kits", label: "Kits" },
  { id: "contacto", label: "Contacto" },
];

const useFilters = Array.from(
  new Map(displayProducts.map((product) => [product.use, { slug: product.use, label: product.useLabel }])).values(),
);
const typeFilters = Array.from(
  new Map(displayProducts.map((product) => [product.type, { slug: product.type, label: product.typeLabel }])).values(),
);

const storeData = {
  announcement: ANNOUNCEMENT,
  freeShippingThreshold: FREE_SHIPPING_THRESHOLD,
  shippingFlat: SHIPPING_FLAT,
  taxRate: TAX_RATE,
  products: displayProducts,
  kits: displayKits,
  accentColors: ACCENT_COLORS,
};
---

<html class="light" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Yoga Verde | Cosmética natural hecha en México</title>
    <meta
      content="Yoga Verde es cosmética natural hecha en México: desmaquillante, agua micelar, crema facial, crema corporal, mousse, bálsamo labial y velas de soya. Compra fácil desde móvil o desktop."
      name="description"
    />
    <meta content="Yoga Verde | Cosmética natural hecha en México" property="og:title" />
    <meta
      content="Cosmética natural hecha en México: cremas, desmaquillante, aceites capilares, bálsamo labial y velas de soya con almendra, coco, uva, lavanda y más."
      property="og:description"
    />
    <meta content="website" property="og:type" />
    <meta content="https://yoga-verde.srv1175749.hstgr.cloud/" property="og:url" />
    <meta
      content="https://yoga-verde.srv1175749.hstgr.cloud/yoga-verde/assets/brand/og-image.png"
      property="og:image"
    />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <link href="/yoga-verde/assets/brand/favicon-32.png" rel="icon" sizes="32x32" type="image/png" />
    <link href="/yoga-verde/assets/brand/favicon-180.png" rel="apple-touch-icon" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link href="https://yoga-verde.srv1175749.hstgr.cloud/" rel="canonical" />
  </head>
  <body class="bg-surface text-on-surface selection:bg-secondary/20 selection:text-primary">
    <script id="yoga-verde-data" is:inline set:html={JSON.stringify(storeData)} type="application/json"></script>

    <div class="min-h-screen bg-surface" data-page-content>
      <div class="sticky top-0 z-[70]">
        <div class="site-announcement px-4 py-2 text-center text-[10px] font-semibold uppercase tracking-[0.2em] sm:text-[11px]">
          {ANNOUNCEMENT}
        </div>
        <header class="site-header border-b border-outline-variant/35 bg-surface/95 backdrop-blur-xl" data-wf-section="header">
          <nav class="relative mx-auto flex h-16 max-w-screen-2xl items-center justify-between gap-4 px-4 sm:px-6 md:h-[4.75rem] md:px-6 lg:px-8" data-wf-hook="nav">
            <div class="flex flex-1 items-center gap-4">
              <details class="mobile-menu relative md:hidden" data-mobile-menu>
                <summary aria-label="Abrir menú" class="header-action relative z-[93] inline-flex h-11 w-11 cursor-pointer list-none items-center justify-center border border-outline-variant/60 text-primary">
                  <span aria-hidden="true" class="material-symbols-outlined">menu</span>
                </summary>
                <button aria-label="Cerrar menú" class="mobile-menu-backdrop" data-close-mobile-menu type="button"></button>
                <div class="mobile-menu-panel" aria-label="Navegación principal">
                  <div class="mobile-menu-panel__header">
                    <div>
                      <p class="product-eyebrow">Yoga Verde</p>
                      <p class="mt-1 font-headline text-3xl text-primary">Explorar</p>
                    </div>
                    <button aria-label="Cerrar menú" class="icon-action" data-close-mobile-menu type="button">
                      <span aria-hidden="true" class="material-symbols-outlined">close</span>
                    </button>
                  </div>
                  <div class="mobile-menu-panel__body">
                    {NAV_ITEMS.map((item) => (
                      <button class="mobile-menu-link" data-nav-link={item.id} data-scroll-to={item.id} type="button">
                        {item.label}
                      </button>
                    ))}
                    <button class="mobile-menu-link" data-focus-search type="button">Buscar productos</button>
                  </div>
                </div>
              </details>
              <div class="hidden items-center gap-6 md:flex">
                {NAV_ITEMS.map((item) => (
                  <button class="nav-link" data-nav-link={item.id} data-scroll-to={item.id} type="button">
                    {item.label}
                  </button>
                ))}
              </div>
            </div>

            <a class="site-logo absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center justify-center" href="#inicio">
              <picture>
                <source media="(max-width: 767px)" srcset="/yoga-verde/assets/brand/logo-monogram.png" />
                <img
                  alt="Yoga Verde — Cosmética natural"
                  class="site-logo-image h-11 w-11 object-contain md:h-[5.5rem] md:w-[5.5rem]"
                  height="1400"
                  src="/yoga-verde/assets/brand/logo-yoga-verde.svg"
                  width="1400"
                />
              </picture>
            </a>

            <div class="flex flex-1 items-center justify-end gap-2 sm:gap-3">
              <button
                aria-label="Buscar en el catálogo"
                class="header-action header-search inline-flex h-11 w-11 items-center justify-center border border-outline-variant/60 text-primary transition hover:border-secondary hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35 lg:h-auto lg:w-auto lg:gap-2 lg:px-4 lg:py-2 lg:text-sm"
                data-focus-search
                type="button"
              >
                <span class="material-symbols-outlined text-base">search</span>
                <span class="hidden lg:inline">Buscar productos</span>
              </button>
              <button
                aria-label="Abrir carrito"
                class="header-action group relative inline-flex h-11 w-11 items-center justify-center border border-outline-variant/60 text-primary transition hover:border-secondary hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
                data-open-cart
                type="button"
              >
                <span class="material-symbols-outlined">shopping_cart</span>
                <span
                  class="absolute -right-1 -top-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-secondary px-1 text-[10px] font-bold text-white"
                  data-cart-count
                >
                  0
                </span>
              </button>
            </div>
          </nav>
        </header>
      </div>

      <main>
        <section class="hero-editorial" data-wf-section="hero" id="inicio">
          <div class="hero-editorial__inner" data-wf-hook="hero-inner">
            <div class="hero-brand-lockup" data-wf-hook="hero-brand">
              <img
                alt="Yoga Verde"
                class="hero-logo"
                height="1400"
                src="/yoga-verde/assets/brand/logo-yoga-verde.svg"
                width="1400"
              />
              <div class="hero-brand-note" aria-hidden="true">
                <span>Yoga Verde · 01—05</span>
                <span>Selección de esenciales</span>
              </div>
            </div>

            <div class="hero-gallery" data-wf-hook="hero-gallery">
              <div class="hero-frame" data-wf-hook="hero-frame">
                <div class="hero-frame__topline" aria-hidden="true">
                  <span>Cosmética natural hecha en México</span>
                  <span>Explorar selección <span class="material-symbols-outlined">south_east</span></span>
                </div>
                <div aria-label="Productos destacados" aria-live="polite" aria-roledescription="carousel" class="hero-slider" data-hero-slider data-wf-hook="hero-slider" role="region">
                  {heroSlides.map((product, index) => (
                    <article
                      class:list={["hero-slide", index === 0 && "is-active"]}
                      data-hero-slide={index}
                    >
                      <img
                        alt={`${product.name}, ${product.scent}`}
                        class="hero-product-image"
                        decoding={index === 0 ? "sync" : "async"}
                        loading={index === 0 ? "eager" : "lazy"}
                        src={product.image}
                      />
                      <div class="hero-caption">
                        <div class="min-w-0">
                          <p class="hero-kicker">{product.typeLabel}</p>
                          <h2 class="product-name hero-product-name">{product.name}</h2>
                          <p class="hero-benefit">{product.short}</p>
                        </div>
                        <button aria-controls="detail-title" aria-haspopup="dialog" class="hero-link" data-open-detail={product.id} type="button">
                          Ver producto
                          <svg aria-hidden="true" class="text-link__icon" fill="none" focusable="false" height="14" viewBox="0 0 24 24" width="14">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                          </svg>
                        </button>
                      </div>
                    </article>
                  ))}
                </div>

                <div class="hero-dots">
                  {heroSlides.map((product, index) => (
                    <button
                      aria-label={`Ver ${product.name}`}
                      class:list={["hero-dot", index === 0 && "is-active"]}
                      data-hero-dot={index}
                      type="button"
                    />
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>


        <section class="reveal ritual-section editorial-section mx-auto max-w-screen-2xl px-4 py-20 sm:px-6 lg:px-8" data-wf-section="best-sellers" id="best-sellers">
          <div class="ritual-section__header">
            <div class="max-w-md">
              <p class="specimen-label text-xs font-semibold uppercase tracking-[0.22em] text-secondary">Rituales esenciales</p>
              <h2 class="mt-3 font-headline text-4xl leading-tight text-primary sm:text-5xl">Lo esencial para empezar.</h2>
              <p class="mt-5 max-w-sm text-sm leading-7 text-on-surface-variant">
                Tres fórmulas para construir una rutina sencilla, sensorial y honesta.
              </p>
            </div>
            <button class="text-link ritual-section__link" data-scroll-to="catalogo" type="button">
              Ver catálogo completo
              <svg aria-hidden="true" class="text-link__icon" fill="none" focusable="false" height="14" viewBox="0 0 24 24" width="14">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
              </svg>
            </button>
          </div>

          <div class="ritual-grid">
            {essentialProducts.map((product) => (
              <article class="ritual-card" style={`--accent: ${accentOf(product)}`}>
                <button aria-controls="detail-title" aria-haspopup="dialog" class="ritual-card__media" data-open-detail={product.id} type="button">
                  <img alt={`${product.name} ${product.scent}`} class="product-media" src={product.image} />
                </button>
                <div class="ritual-card__body">
                  <p class="product-eyebrow">{product.typeLabel}</p>
                  <h3 class="product-name ritual-card__title">{product.name}</h3>
                  <p class="ritual-card__scent">{product.scent}</p>
                  <div class="ritual-card__footer">
                    <span class="price">{formatMoney(product.price)}</span>
                    <button aria-controls="detail-title" aria-haspopup="dialog" class="text-link" data-open-detail={product.id} type="button">
                      Descubrir
                      <svg aria-hidden="true" class="text-link__icon" fill="none" focusable="false" height="14" viewBox="0 0 24 24" width="14">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                      </svg>
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        

        <section class="catalog-editorial reveal editorial-section relative overflow-hidden px-4 py-14 sm:px-6 lg:px-8" data-wf-section="catalog" id="catalogo">
          <div class="relative mx-auto max-w-screen-2xl">
            <div class="catalog-heading">
              <div class="min-w-0">
                <h2 class="font-headline text-3xl text-primary sm:text-4xl">Catálogo completo</h2>
                <p class="mt-2 text-sm text-on-surface-variant">
                  <span data-product-count>{displayProducts.length}</span> productos
                </p>
              </div>
              <div class="catalog-search-row">
                <div class="catalog-search">
                <span class="material-symbols-outlined text-on-surface-variant">search</span>
                <input
                  aria-label="Buscar productos"
                  class="w-full border-none bg-transparent p-0 text-sm text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:ring-0"
                  data-search-input
                  placeholder="Buscar almendra, crema facial, vela de soya..."
                  type="search"
                />
                </div>
              <button
                aria-label="Abrir filtros"
                class="secondary-action"
                data-open-filters
                type="button"
              >
                <span class="material-symbols-outlined text-base">tune</span>
                Filtrar
              </button>
            </div>
          </div>

          <div class="grid gap-8">
            <div class="pointer-events-none fixed inset-0 z-[72] bg-primary/20 opacity-0 transition" data-filters-overlay></div>
            <aside
              class="filters-drawer hide-scrollbar fixed inset-y-0 left-0 z-[80] w-[88vw] max-w-sm -translate-x-full overflow-y-auto bg-surface-container-lowest p-6 shadow-float transition duration-300"
              data-filters-drawer
            >
              <div class="mb-8 flex items-center justify-between">
                <div>
                  <p class="product-eyebrow">Filtros</p>
                  <h3 class="mt-2 font-headline text-3xl text-primary">Encuentra tu producto</h3>
                </div>
                <button
                  aria-label="Cerrar filtros"
                  class="icon-action"
                  data-close-filters
                  type="button"
                >
                  <span class="material-symbols-outlined">close</span>
                </button>
              </div>

              <div class="space-y-8">
                <div>
                  <h3 class="font-headline text-xl text-primary">Familia de aroma</h3>
                  <div class="mt-4 grid gap-2">
                    {useFilters.map((useFilter) => (
                      <button
                        aria-pressed="false"
                        class="filter-option"
                        data-filter-use={useFilter.slug}
                        type="button"
                      >
                        {useFilter.label}
                      </button>
                    ))}
                  </div>
                </div>

                <div>
                  <h3 class="font-headline text-xl text-primary">Categoría</h3>
                  <div class="mt-4 grid gap-2">
                    {typeFilters.map((typeFilter) => (
                      <button
                        aria-pressed="false"
                        class="filter-option"
                        data-filter-type={typeFilter.slug}
                        type="button"
                      >
                        {typeFilter.label}
                      </button>
                    ))}
                  </div>
                </div>



                <button
                  class="secondary-action w-full"
                  data-clear-filters
                  type="button"
                >
                  Limpiar filtros
                </button>
              </div>
            </aside>

            <div class="min-w-0">
              <div class="catalog-status">
                <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
                  <div>
                    <p class="product-eyebrow">
                      <span data-product-count-filtered>{displayProducts.length}</span> piezas visibles
                    </p>
                    <div class="mt-4 flex flex-wrap gap-2" data-active-filters></div>
                  </div>
                </div>
              </div>

              <div class="catalog-grid mt-8 grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-6 sm:gap-y-12 xl:grid-cols-3" data-products-grid>
                {displayProducts.map((product) => (
                  <article
                    class="product-card group"
                    data-wf-hook="product-card"
                    style={`--accent: ${accentOf(product)}`}
                  >
                    <div class="product-image-frame relative">
                      {product.badge && <span class="product-badge absolute left-4 top-4 z-10">{product.badge}</span>}
                      <img
                        alt={`${product.name} ${product.scent}`}
                        class="product-media aspect-square w-full transition duration-500 group-hover:scale-[1.02]"
                        src={product.image}
                      />
                    </div>
                    <div class="product-card__body">
                      <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                          <p class="product-eyebrow">{product.typeLabel}</p>
                          <h3 class="product-name product-card__title">{product.name}</h3>
                          <p class="product-card__scent">{product.scent}</p>
                        </div>
                        <span class="price shrink-0 text-lg">{formatMoney(product.price)}</span>
                      </div>
                      <p class="product-card__description">{product.short}</p>
                      <div class="product-card__meta">
                        <span>{product.useLabel}</span>
                        {product.size && <span>{product.size}</span>}
                      </div>
                      <div class="product-card__actions">
                        <button aria-controls="detail-title" aria-haspopup="dialog" class="text-link" data-open-detail={product.id} type="button">
                      <svg aria-hidden="true" class="text-link__icon" fill="none" focusable="false" height="14" viewBox="0 0 24 24" width="14">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                      </svg>
                      Ver detalle
                    </button>
                        <button
                          aria-label={`Añadir ${product.name} al carrito`}
                          class="primary-action"
                          data-add-item={product.id}
                          type="button"
                        >
                          Añadir
                        </button>
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              <div
                class="mt-8 hidden border border-dashed border-outline-variant/80 bg-surface-container-lowest p-10 text-center"
                data-empty-state
              >
                <p class="font-headline text-3xl text-primary">Sin coincidencias</p>
                <p class="mt-3 text-on-surface-variant">
                  Cambia filtros o limpia la búsqueda para volver a ver el catálogo completo.
                </p>
              </div>
            </div>
          </div>
          </div>
        </section>


        <section class="reveal editorial-section mx-auto max-w-screen-2xl px-4 py-20 sm:px-6 lg:px-8" data-wf-section="kits" id="kits">
          <div class="kit-feature">
            <div class="kit-feature__media">
              <div class="kit-feature__wash"></div>
              <div class="kit-feature__products">
                {kitItems(featuredKit).map((piece, index) => (
                  <img
                    alt={`${piece.name} ${piece.scent}`}
                    class:list={["product-media", index === 1 && "is-raised", index === 2 && "is-small"]}
                    loading="lazy"
                    src={piece.image}
                  />
                ))}
              </div>
            </div>
            <div class="kit-feature__content">
              <p class="specimen-label text-xs font-semibold uppercase tracking-[0.22em] text-secondary">Colección para empezar</p>
              <h2 class="mt-4 font-headline text-4xl leading-tight text-primary sm:text-5xl">{featuredKit.name}</h2>
              <p class="mt-5 max-w-md text-base leading-8 text-on-surface-variant">
                Una rutina completa en tres pasos: limpiar, hidratar y cuidar la zona de ojos con fórmulas botánicas hechas en México.
              </p>
              <div class="kit-feature__price">
                <span class="price text-2xl">{formatMoney(featuredKit.price)}</span>
                <span class="text-sm text-on-surface-variant">{kitItems(featuredKit).length} productos · precio especial</span>
              </div>
              <button aria-controls="detail-title" aria-haspopup="dialog" class="primary-action mt-8" data-open-detail={featuredKit.id} type="button">
                Explorar kit
                <svg aria-hidden="true" class="text-link__icon" fill="none" focusable="false" height="14" viewBox="0 0 24 24" width="14">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                </svg>
              </button>
            </div>
          </div>

          <div class="kit-list-link">
            <span>Descubre todos nuestros kits y regalos</span>
            <button class="text-link" data-scroll-to="catalogo" type="button">
              Ver catálogo
              <svg aria-hidden="true" class="text-link__icon" fill="none" focusable="false" height="14" viewBox="0 0 24 24" width="14">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
              </svg>
            </button>
          </div>
        </section>

