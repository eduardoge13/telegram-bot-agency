          var visibleCount = Math.min(Math.max(requestedCount, 1), randomizedSlides.length);
          var selectedSlides = randomizedSlides.slice(0, visibleCount);
          var selectedIds = new Set(selectedSlides.map(function (slide) {
            return slide.dataset.heroProduct;
          }));
          var dotByProduct = new Map(dots.map(function (dot) {
            return [dot.dataset.heroProduct, dot];
          }));

          slides.forEach(function (slide) {
            var selected = selectedIds.has(slide.dataset.heroProduct);
            slide.hidden = !selected;
            slide.classList.remove("is-active", "is-entering", "is-leaving", "is-forward", "is-backward");
          });
          dots.forEach(function (dot) {
            dot.hidden = !selectedIds.has(dot.dataset.heroProduct);
            dot.classList.remove("is-active");
          });

          slides = selectedSlides;
          dots = selectedSlides.map(function (slide, index) {
            var dot = dotByProduct.get(slide.dataset.heroProduct);
            slide.dataset.heroSlide = String(index);
            slider.appendChild(slide);
            if (dot) {
              dot.dataset.heroDot = String(index);
              dot.parentElement?.appendChild(dot);
            }
            return dot;
          }).filter(Boolean);

          slides[0].hidden = false;
          slides[0].classList.add("is-active");
          var firstHeroImage = slides[0].querySelector("img");
          if (firstHeroImage) {
            firstHeroImage.loading = "eager";
            firstHeroImage.fetchPriority = "high";
          }
          if (dots[0]) dots[0].classList.add("is-active");
          slider.dataset.heroSelection = slides.map(function (slide) {
            return slide.dataset.heroProduct;
          }).join(",");
        }

        if (slides.length > 1) {
          var current = 0;
          var timer = null;
          var enterTimer = null;

          var showSlide = function (index, direction, animate) {
            var next = (index + slides.length) % slides.length;
            var movement = direction || (next >= current ? "forward" : "backward");
            var movementClass = movement === "backward" ? "is-backward" : "is-forward";
            var outgoing = slides[current];

            if (enterTimer) {
              window.clearTimeout(enterTimer);
              enterTimer = null;
            }

            slides.forEach(function (slide, i) {
              slide.classList.remove("is-entering", "is-leaving", "is-forward", "is-backward");
              slide.classList.toggle("is-active", i === next);
            });

            if (animate && outgoing !== slides[next]) {
              outgoing.classList.add("is-leaving", movementClass);
              slides[next].classList.add("is-entering", movementClass);
              enterTimer = window.setTimeout(function () {
                outgoing.classList.remove("is-leaving", "is-forward", "is-backward");
                slides[next].classList.remove("is-entering", "is-forward", "is-backward");
              }, 900);
            }

            current = next;
            dots.forEach(function (dot, i) {
              dot.classList.toggle("is-active", i === current);
            });
          };

          var stopAuto = function () {
            if (timer) {
              window.clearInterval(timer);
              timer = null;
            }
          };

          dots.forEach(function (dot) {
            dot.addEventListener("click", function () {
              stopAuto();
              var requested = Number(dot.dataset.heroDot);
              showSlide(requested, requested >= current ? "forward" : "backward", !prefersReduced);
            });
          });

          if (!prefersReduced) {
            timer = window.setInterval(function () {
              showSlide(current + 1, "forward", true);
            }, 5000);
            if (slider) {
              slider.addEventListener("mouseenter", stopAuto);
              slider.addEventListener("focusin", stopAuto);
            }
          }

          if (slider) {
            window.requestAnimationFrame(function () {
              window.requestAnimationFrame(function () {
                slider.classList.add("is-ready");
                slider.closest(".hero-frame")?.classList.add("is-ready");
              });
            });

            if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
              var heroFrame = slider.closest(".hero-frame");
              slider.addEventListener("pointermove", function (event) {
                var bounds = slider.getBoundingClientRect();
                var x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 10;
                var y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 6;
                slider.style.setProperty("--hero-parallax-x", x.toFixed(2) + "px");
                slider.style.setProperty("--hero-parallax-y", y.toFixed(2) + "px");
                if (heroFrame) {
                  heroFrame.style.setProperty("--hero-bg-x", (x * 0.35).toFixed(2) + "px");
                  heroFrame.style.setProperty("--hero-bg-y", (y * 0.35).toFixed(2) + "px");
                }
              });
              slider.addEventListener("pointerleave", function () {
                slider.style.setProperty("--hero-parallax-x", "0px");
                slider.style.setProperty("--hero-parallax-y", "0px");
                if (heroFrame) {
                  heroFrame.style.setProperty("--hero-bg-x", "0px");
                  heroFrame.style.setProperty("--hero-bg-y", "0px");
                }
              });
            }

            // Touch-first carousel: a horizontal swipe changes the hero slide
            // while a tap still reaches the product CTA normally.
            var swipeStartX = null;
            slider.addEventListener("pointerdown", function (event) {
              if (event.pointerType === "mouse") return;
              swipeStartX = event.clientX;
            });
            slider.addEventListener("pointerup", function (event) {
              if (swipeStartX === null || event.pointerType === "mouse") return;
              var delta = event.clientX - swipeStartX;
              swipeStartX = null;
              if (Math.abs(delta) < 44) return;
              stopAuto();
              showSlide(current + (delta < 0 ? 1 : -1), delta < 0 ? "forward" : "backward", !prefersReduced);
            });
            slider.addEventListener("pointercancel", function () {
              swipeStartX = null;
            });
          }
        }

        // The first mobile product story is a real touch carousel. Cards remain
        // full-width, snap cleanly and expose explicit progress so the visitor
        // never sees a product cut in half or loses their place.
        var ritualRail = document.querySelector("[data-ritual-rail]");
        var ritualCards = ritualRail ? ritualRail.querySelectorAll("[data-ritual-card]") : [];
        var ritualDots = document.querySelectorAll("[data-ritual-dot]");
        var ritualStep = document.querySelector("[data-ritual-step]");
        var ritualScrollQueued = false;

        var syncRitualRail = function () {
          ritualScrollQueued = false;
          if (!ritualRail || !ritualCards.length || window.innerWidth >= 768) return;
          var railBounds = ritualRail.getBoundingClientRect();
          var center = railBounds.left + railBounds.width / 2;
          var activeIndex = 0;
          var closest = Infinity;
          ritualCards.forEach(function (card, index) {
            var bounds = card.getBoundingClientRect();
            var distance = Math.abs(bounds.left + bounds.width / 2 - center);
            if (distance < closest) {
              closest = distance;
              activeIndex = index;
            }
          });
          ritualDots.forEach(function (dot, index) {
            dot.classList.toggle("is-active", index === activeIndex);
          });
          if (ritualStep) ritualStep.textContent = String(activeIndex + 1).padStart(2, "0");
        };

        var requestRitualRail = function () {
          if (ritualScrollQueued) return;
          ritualScrollQueued = true;
          window.requestAnimationFrame(syncRitualRail);
        };

        if (ritualRail && ritualCards.length) {
          ritualRail.addEventListener("scroll", requestRitualRail, { passive: true });
          window.addEventListener("resize", requestRitualRail, { passive: true });
          ritualDots.forEach(function (dot) {
            dot.addEventListener("click", function () {
              var index = Number(dot.dataset.ritualDot);
              if (!ritualCards[index]) return;
              ritualCards[index].scrollIntoView({
                behavior: prefersReduced ? "auto" : "smooth",
                block: "nearest",
                inline: "center",
              });
            });
          });
          syncRitualRail();
        }

        // Scrollspy.
        //
        // La versión anterior elegía la sección con mayor `intersectionRatio`,
        // lo que es inestable: una sección más alta que el viewport (el catálogo,
        // con 27 productos) nunca supera un ratio bajo, así que cualquier sección
        // corta totalmente visible le ganaba y el resaltado saltaba de una a otra.
        //
        // Aquí se observa una banda de 1px justo debajo del header sticky: solo
        // una sección puede cruzarla a la vez, así que el resultado es determinista
        // y no depende de la altura de la sección.
        var stickyHeader = document.querySelector(".sticky");
        var navLinks = document.querySelectorAll("[data-nav-link]");

        var spySections = [];
        var seenSections = {};
        navLinks.forEach(function (link) {
          var id = link.dataset.navLink;
          if (seenSections[id]) return;
          var section = document.getElementById(id);
          if (section) {
            seenSections[id] = true;
            spySections.push(section);
          }
        });

        if (spySections.length) {
          var activeId = null;
          var setActive = function (id) {
            if (!id || id === activeId) return;
            activeId = id;
            navLinks.forEach(function (link) {
              var on = link.dataset.navLink === id;
              link.classList.toggle("is-active", on);
              if (on) {
                link.setAttribute("aria-current", "true");
              } else {
                link.removeAttribute("aria-current");
              }
            });
          };

          // La altura real del header alimenta tanto la banda del observer como
          // el scroll-margin-top de las secciones, para que al navegar el título
          // quede visible y no debajo del header.
          var syncHeaderHeight = function () {
            var h = stickyHeader ? Math.round(stickyHeader.getBoundingClientRect().height) : 112;
            document.documentElement.style.setProperty("--header-h", h + "px");
            return h;
          };

          var spy = null;
          var buildObserver = function () {
            if (spy) spy.disconnect();
            var h = syncHeaderHeight();
            // La banda va algunos píxeles POR DEBAJO del punto donde aterriza una
            // sección al navegar (scroll-margin-top = header + 12px). Si se
            // colocara justo en el borde del header, tras hacer click la banda
            // quedaría todavía dentro de la sección anterior y el resaltado se
            // marcaría una sección atrás.
            var band = h + 32;
            var bottom = Math.max(0, window.innerHeight - band - 1);
            spy = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) setActive(entry.target.id);
                });
              },
              { threshold: 0, rootMargin: "-" + band + "px 0px -" + bottom + "px 0px" },
            );
            spySections.forEach(function (section) {
              spy.observe(section);
            });
          };

          if ("IntersectionObserver" in window) {
            buildObserver();
            window.addEventListener("resize", buildObserver);
          }

          // Estado correcto al cargar: arriba del todo es "inicio"; con hash, la
          // sección del hash. El observer se encarga del resto al hacer scroll.
          var initial = window.location.hash.replace("#", "");
          if (initial && seenSections[initial]) {
            setActive(initial);
          } else {
            setActive(spySections[0].id);
          }

          // Volver arriba siempre debe marcar "inicio", aunque la banda no
          // llegue a cruzar ninguna sección.
          window.addEventListener(
            "scroll",
            function () {
              if (window.scrollY < 8) setActive(spySections[0].id);
            },
            { passive: true },
          );
        }
      })();
    </script>
    <!-- Detalle de producto.
         Antes era un div centrado con -translate-y-1/2 sin max-height ni scroll
         propio: en 400x692 medía 376x1277, así que ~585px quedaban fuera de la
         pantalla y, con el body bloqueado, no había forma de alcanzarlos.
         Ahora es una hoja a pantalla completa con su propio scroll. -->
    <div class="detail-overlay" data-modal-overlay></div>
    <div
      aria-labelledby="detail-title"
      aria-modal="true"
      aria-hidden="true"
      class="detail-panel"
      data-detail-modal
      role="dialog"
      tabindex="-1"
    >
      <div class="detail-bar">
        <p class="min-w-0 truncate text-xs uppercase tracking-[0.22em] text-on-surface-variant" data-detail-badge></p>
        <button
          aria-label="Cerrar detalle"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-outline-variant/50 bg-surface-container-lowest text-primary transition hover:border-secondary/40 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/40"
          data-close-detail
          type="button"
        >
          <span aria-hidden="true" class="material-symbols-outlined">close</span>
        </button>
      </div>

      <div class="detail-body">
        <div class="detail-media mx-auto w-full max-w-[22rem] md:max-w-none" data-detail-media>
          <figure class="detail-media__item" style="--piece-index: 0">
            <img
              alt=""
              class="product-media mx-auto block aspect-square w-full bg-surface-container-lowest"
              data-detail-image
              src=""
            />
          </figure>
        </div>

        <div class="mt-5 md:mt-0">
          <h2 class="product-name font-headline text-2xl leading-tight text-primary" data-detail-title id="detail-title"></h2>
          <p class="mt-1 text-sm text-on-surface-variant" data-detail-scent></p>
          <p class="price mt-3 text-2xl" data-detail-price></p>

          <p class="mt-4 leading-7 text-on-surface-variant" data-detail-description></p>

          <div class="mt-5 flex flex-wrap gap-2" data-detail-tags></div>

          <details class="product-accordion mt-6" data-detail-benefits-block>
            <summary>
              <span>Beneficios</span>
              <span aria-hidden="true" class="product-accordion__icon"></span>
            </summary>
            <ul class="product-accordion__content space-y-2.5 text-sm leading-6 text-on-surface-variant" data-detail-benefits></ul>
          </details>

          <details class="product-accordion" data-detail-instructions-block>
            <summary>
              <span>Cómo usarlo</span>
              <span aria-hidden="true" class="product-accordion__icon"></span>
            </summary>
            <p class="product-accordion__content text-sm leading-6 text-on-surface-variant" data-detail-instructions></p>
          </details>
        </div>
      </div>

      <div class="detail-cta">
        <button
          class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-2xl bg-primary px-5 font-semibold text-on-primary transition hover:bg-primary-container focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35"
          data-detail-add
          type="button"
        >
          Añadir al carrito
          <span aria-hidden="true" class="material-symbols-outlined text-lg">add_shopping_cart</span>
        </button>
      </div>
    </div>

    <!-- Versiona este entrypoint porque vive en public/ y no recibe hash de Astro. -->
    <script defer is:inline src="/yoga-verde/shop.js?v=20260809-kit-gallery-v1"></script>
  </body>
</html>
