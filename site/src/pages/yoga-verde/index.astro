        var storyStage = document.querySelector("[data-story-stage]");
        var storyProducts = storyStage ? storyStage.querySelectorAll("[data-story-product]") : [];
        var storySelectors = storyStage ? storyStage.querySelectorAll("[data-story-select]") : [];
        var storyStep = storyStage ? storyStage.querySelector("[data-story-step]") : null;
        var scrollMotionQueued = false;

        var clamp = function (value, min, max) {
          return Math.min(max, Math.max(min, value));
        };

        var setStoryIndex = function (requestedIndex) {
          if (!storyProducts.length) return;
          var activeIndex = clamp(requestedIndex, 0, storyProducts.length - 1);
          storyProducts.forEach(function (product, index) {
            product.classList.toggle("is-active", index === activeIndex);
