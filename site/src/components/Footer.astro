---
import { brand, homeContent, localizedPaths, type Locale } from '../config/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = homeContent[locale].footer;
---

<footer class="bg-brand-navy-deep text-white/80">
	<div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-14 sm:grid-cols-3">
		<div>
			<div class="flex items-center gap-2 text-lg font-extrabold text-white">
				<span class="h-2.5 w-2.5 rounded-full bg-brand-coral" aria-hidden="true"></span>
				{brand.name}
			</div>
			<p class="mt-3 max-w-xs text-sm text-white/60">{copy.blurb}</p>
		</div>

		<div>
			<p class="text-xs font-bold uppercase tracking-wider text-white/50">{copy.legal}</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li><a class="transition hover:text-white" href={localizedPaths.privacy[locale]}>{copy.privacy}</a></li>
				<li><a class="transition hover:text-white" href={localizedPaths.terms[locale]}>{copy.terms}</a></li>
				<li><a class="transition hover:text-white" href={localizedPaths.dataDeletion[locale]}>{copy.dataDeletion}</a></li>
			</ul>
		</div>

		<div>
			<p class="text-xs font-bold uppercase tracking-wider text-white/50">Contact</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li><a class="transition hover:text-white" href={`mailto:${brand.salesEmail}`}>{brand.salesEmail}</a></li>
				<li><a class="transition hover:text-white" href={`mailto:${brand.privacyEmail}`}>{brand.privacyEmail}</a></li>
				<li>
					<a class="transition hover:text-white" href={`https://wa.me/${brand.whatsappE164}`} target="_blank" rel="noreferrer">
						{brand.whatsappDisplay}
					</a>
				</li>
			</ul>
		</div>
	</div>
</footer>
